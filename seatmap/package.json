{
  "name": "seatmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "楼层工位图 - 可视化布局 / 编辑 / 搜索 / Excel 导入",
  "scripts": {
    "dev": "vite",
    "seed": "node tools/build-seed.mjs",
    "sample": "node tools/make-sample.mjs",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.js\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.js\" \"tools/**/*.mjs\"",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "fuse.js": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "konva": "^9.3.16",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18",
    "@typescript-eslint/parser": "7.18",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "8.57",
    "eslint-config-prettier": "9.1",
    "eslint-plugin-react-hooks": "4.6",
    "prettier": "3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.0"
  }
}
